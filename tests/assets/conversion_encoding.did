// Values whose JavaScript encoding is easy to get wrong.
//
// `zero`, `no` and `empty` are present-but-falsy optionals: a truthiness test encodes them as
// absent. `constructor` and `toString` are variant tags that exist on `Object.prototype`, so
// an `in` test matches them on every object.
type Falsy = record {
  zero : opt nat;
  no : opt bool;
  empty : opt text;
  missing : opt nat;
};

type Inherited = variant { constructor; toString; plain };

// A variant carrying an optional payload takes the discriminated-union path, which is
// separate from the record path.
type Payload = variant { count : opt nat; other : text };

// An optional field named after an inherited member: reading it off an object that omits it
// yields `Object.prototype.toString`, which is never absent.
type Shadowed = record { toString : opt text; ok : nat };

service : () -> {
  // A bare `opt` argument converts through its own path rather than a record's field test.
  round_trip_opt : (opt nat) -> (opt nat);
  round_trip_falsy : (Falsy) -> (Falsy);
  round_trip_inherited : (Inherited) -> (Inherited);
  round_trip_shadowed : (Shadowed) -> (Shadowed);
  round_trip_payload : (Payload) -> (Payload);
}
