// Variant payloads of nested options. A payload has no slot of its own for the outer level —
// `null` is already the absent payload — so a payload of `opt opt T` is typed as the
// standalone nested option, `Some<T | null> | None`, and converts as one.
//
// `a` is `p` with a name standing for the inner option: one candid type, so one declaration
// and one conversion.
type Cfg = record { x : nat };
type Inner = opt Cfg;
type Update = variant {
  p : opt opt Cfg;
  d : opt opt opt nat;
  q : opt nat;
  a : opt Inner;
  r;
};

service : {
  round_trip : (Update) -> (Update);
}
