import type { ActorMethod } from '@icp-sdk/core/agent';
import type { Principal } from '@icp-sdk/core/principal';
import { IDL } from '@icp-sdk/core/candid';

export interface ActorMethod_ { 'y' : bigint }
export interface IDL_ {
  'f' : ActorMethod<
    [ActorMethod_, _SERVICE_, idlFactory_, init_, idlService_, idlInitArgs_],
    undefined
  >,
  'round_trip' : ActorMethod<[Principal_], Principal_>,
}
/**
 * Names the generated declarations files occupy themselves: the JavaScript factory imports
 * `IDL` and binds it as its parameter, the TypeScript declarations import `Principal` and
 * `ActorMethod`, and both export `_SERVICE`, `idlFactory` and `init` — plus `idlService` and
 * `idlInitArgs` with root exports. The main service is the `IDL` alias so the actor
 * reference is escaped the same way as the declaration it points at. The variant is here so
 * the conversion path — which imports the candid shape under the escaped name — is
 * exercised too.
 */
export type Principal_ = { 'a' : null } |
  { 'b' : null };
export interface _SERVICE_ { 't' : bigint }
export interface idlFactory_ { 'p' : bigint }
export interface idlInitArgs_ { 's' : bigint }
export interface idlService_ { 'r' : bigint }
export interface init_ { 'q' : bigint }
export interface _SERVICE extends IDL_ {}
export const ActorMethod_ = IDL.Record({ 'y' : IDL.Nat });
export const _SERVICE_ = IDL.Record({ 't' : IDL.Nat });
export const idlFactory_ = IDL.Record({ 'p' : IDL.Nat });
export const init_ = IDL.Record({ 'q' : IDL.Nat });
export const idlService_ = IDL.Record({ 'r' : IDL.Nat });
export const idlInitArgs_ = IDL.Record({ 's' : IDL.Nat });
export const Principal_ = IDL.Variant({ 'a' : IDL.Null, 'b' : IDL.Null });
export const IDL_ = IDL.Service({
  'f' : IDL.Func(
      [ActorMethod_, _SERVICE_, idlFactory_, init_, idlService_, idlInitArgs_],
      [],
      [],
    ),
  'round_trip' : IDL.Func([Principal_], [Principal_], []),
});

export const idlService: IDL.ServiceClass = IDL_;

export const idlInitArgs: IDL.Type[] = [];

export const idlFactory: IDL.InterfaceFactory = ({ IDL }) => {
  const ActorMethod_ = IDL.Record({ 'y' : IDL.Nat });
  const _SERVICE_ = IDL.Record({ 't' : IDL.Nat });
  const idlFactory_ = IDL.Record({ 'p' : IDL.Nat });
  const init_ = IDL.Record({ 'q' : IDL.Nat });
  const idlService_ = IDL.Record({ 'r' : IDL.Nat });
  const idlInitArgs_ = IDL.Record({ 's' : IDL.Nat });
  const Principal_ = IDL.Variant({ 'a' : IDL.Null, 'b' : IDL.Null });
  const IDL_ = IDL.Service({
    'f' : IDL.Func(
        [
          ActorMethod_,
          _SERVICE_,
          idlFactory_,
          init_,
          idlService_,
          idlInitArgs_,
        ],
        [],
        [],
      ),
    'round_trip' : IDL.Func([Principal_], [Principal_], []),
  });
  
  return IDL_;
};

export const init: (args: { IDL: typeof IDL }) => IDL.Type[] = ({ IDL }) => {
  return [];
};
